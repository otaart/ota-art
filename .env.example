# Public address of the site (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://ota.art

# Resend (inquiry and newsletter emails). Without a key the forms answer
# "temporarily unavailable" and nothing is sent.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. studio@send.ota.art
MAIL_FROM="ota.art <studio@send.ota.art>"
# Where inquiries go
INQUIRY_TO=nini@ota.art
# Resend segment (newsletter list) that confirmed subscribers join
RESEND_SEGMENT_ID=
# Random secret (32+ characters) that signs the newsletter confirmation links
SUBSCRIBE_SECRET=

# Cloudflare Turnstile spam check (optional until keys exist)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Sheets copy of each inquiry: a Google Apps Script web app URL (optional)
INQUIRY_SHEET_WEBHOOK=
